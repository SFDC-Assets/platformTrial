me"]},"showActionMenu":true,"measureAxis2":{"sqrtScale":false,"showTitle":true,"showAxis":true,"title":"","customDomain":{"showDomain":false}},"measureAxis1":{"sqrtScale":false,"showTitle":true,"showAxis":true,"title":"Avg EPT","customDomain":{"showDomain":false}},"step":"Avg_EPT_By_Browser_2"},"type":"chart"},"chart_31":{"parameters":{"autoFitMode":"keepLabels","centerText":"","bins":{"breakpoints":{"high":100,"low":0},"bands":{"high":{"color":"#008000","label":""},"low":{"color":"#B22222","label":""},"medium":{"color":"#ffa500","label":""}}},"legend":{"descOrder":false,"showHeader":true,"show":true,"customSize":"auto","position":"right-top","inside":false},"showMeasureTitle":false,"axisMode":"multi","tooltip":{"content":{"legend":{"showBinLabel":true,"measures":[],"showNullValues":true,"customizeLegend":false,"showPercentage":true,"showDimensions":true,"showMeasures":true,"dimensions":[]}}},"visualizationType":"pie","exploreLink":true,"title":{"fontSize":14,"subtitleFontSize":11,"label":"Average EPT by Object","align":"left","subtitleLabel":""},"binValues":false,"trellis":{"flipLabels":false,"showGridLines":true,"size":[100,100],"enable":false,"type":"x","chartsPerLine":4},"inner":60,"columnMap":{"trellis":[],"dimension":["PageObjectType"],"plots":["avg_EffectivePageTime"]},"showActionMenu":true,"centerValueType":"none","measureAxis2":{"sqrtScale":false,"showTitle":true,"showAxis":true,"title":"","customDomain":{"showDomain":false}},"measureAxis1":{"sqrtScale":false,"showTitle":true,"showAxis":true,"title":"","customDomain":{"showDomain":false}},"valueType":"compactNumber","theme":"dark","step":"EPTByApp_1","compactDecimalDigits":-1,"dimensionAxis":{"showTitle":true,"customSize":"auto","showAxis":true,"title":"","icons":{"useIcons":false,"iconProps":{"fit":"cover","column":"","type":"round"}}},"applyConditionalFormatting":true},"type":"chart"},"chart_30":{"parameters":{"autoFitMode":"keepLabels","centerText":"","bins":{"breakpoints":{"high":100,"low":0},"bands":{"high":{"color":"#008000","label":""},"low":{"color":"#B22222","label":""},"medium":{"color":"#ffa500","label":""}}},"legend":{"descOrder":false,"showHeader":true,"show":true,"customSize":"auto","position":"right-top","inside":false},"showMeasureTitle":false,"axisMode":"multi","tooltip":{"content":{"legend":{"showBinLabel":true,"measures":[],"showNullValues":true,"customizeLegend":false,"showPercentage":true,"showDimensions":true,"showMeasures":true,"dimensions":[]}}},"visualizationType":"pie","exploreLink":true,"title":{"fontSize":14,"subtitleFontSize":11,"label":"Average EPT by App ","align":"left","subtitleLabel":""},"binValues":false,"trellis":{"flipLabels":false,"showGridLines":true,"size":[100,100],"enable":false,"type":"x","chartsPerLine":4},"inner":60,"columnMap":{"trellis":[],"dimension":["PageAppName"],"plots":["avg_EffectivePageTime"]},"showActionMenu":true,"centerValueType":"none","measureAxis2":{"sqrtScale":false,"showTitle":true,"showAxis":true,"title":"","customDomain":{"showDomain":false}},"measureAxis1":{"sqrtScale":false,"showTitle":true,"showAxis":true,"title":"","customDomain":{"showDomain":false}},"valueType":"compactNumber","theme":"dark","step":"EPTByGeo_2","compactDecimalDigits":-1,"dimensionAxis":{"showTitle":true,"customSize":"auto","showAxis":true,"title":"","icons":{"useIcons":false,"iconProps":{"fit":"cover","column":"","type":"round"}}},"applyConditionalFormatting":true},"type":"chart"},"text_36":{"parameters":{"content":{"richTextContent":[{"attributes":{"size":"14px","color":"#e6ecf2"},"insert":"Summary Data Table (slow executions >= 5s)"},{"attributes":{"align":"left"},"insert":"\n"}]},"interactions":[],"showActionMenu":true},"type":"text"},"text_35":{"parameters":{"content":{"richTextContent":[{"attributes":{"size":"12px","color":"#ffffff"},"insert":"The Details Table is where you begin to decide what specific part of the codebase to investigate. If you have made several selections on the dashboard, you should have identified some code or a particular day during which performance was poor. Based on those selections, the details table displays all the fun and exciting details of each execution."},{"attributes":{},"insert":"\n"},{"attributes":{"size":"12px","color":"#ffffff"},"insert":"It is important that you review the Apex Execution Event Log manual (https://sfdc.co/ApexExecutionWithUserss) to understand the log details. But here's a brief explainer: RUN_TIME is the total execution time. RUN_TIME is the sum of CPU_TIME, DB_TOTAL_TIME, EXEC_TIME and CALLOUT_TIME."},{"attributes":{},"insert":"\n"},{"attributes":{"size":"12px","color":"#ffffff"},"insert":"If RUN_TIME is higher than normal, see what metric is contributing most: if it is CPU_TIME or EXEC_TIME, that means there is some very complex logic (if statements, for loops, dynamic Apex) and will require a developer to investigate; if it is DB_TOTAL_TIME and there are a low NUMBER_SOQL_QUERIES, that means the few SOQL queries need to be optimised (https://sfdc.co/SOQLTuning), or, if the NUMBER_SOQL_QUERIES is high, it may mean there are repeated queries that could be served by Apex Caching; if CALLOUT_TIME is high, investigate the Apex Callout log type to investigate which URL endpoint was being contacted and adding to round-trip network time."},{"attributes":{},"insert":"\n"},{"attributes":{"size":"12px","color":"#ffffff"},"insert":"In summary: the class or method identified will help you identify which owner in the codebase to contact; the specific performance metric will inform you and them what skillset is needed to investigate the code further."},{"attributes":{},"insert":"\n"},{"attributes":{"size":"12px","color":"#ffffff"},"insert":"Note, actual investigation of the code, line-by-line, will require reproducing the issue and investigating the Debug Logs."},{"attributes":{"align":"left"},"insert":"\n"}]},"interactions":[],"showActionMenu":true},"type":"text"},"text_38":{"parameters":{"content":{"richTextContent":[{"attributes":{"size":"12px","color":"#ffffff"},"insert":"This is a chart of average Run Time (total execution time) for all classes and methods. We use a general Warning level of 3 seconds, and a Critical level of 5 seconds. Any days that see an average Run Time cross these thresholds warrants an investigation. Select any of the Class or Method rows in the summary table below or the Worst Performers tables above to see a trend of how that specific Class or Method performed over time. If any of the thresholds are reached, use the Execution Details table at the bottom of the dashboard to investigate further."},{"attributes":{"align":"left"},"insert":"\n\n"}]},"interactions":[],"showActionMenu":true},"type":"text"},"text_37":{"parameters":{"content":{"richTextContent":[{"attributes":{"size":"10px","color":"#ffffff"},"insert":"QUIDDITY Legend:"},{"attributes":{},"insert":"\n\n"},{"attributes":{"size":"12px","color":"#ffffff"},"insert":"A\t-\tBatch Apex"},{"attributes":{},"insert":"\n"},{"attributes":{"size":"12px","color":"#ffffff"},"insert":"B\t-\tBulk API"},{"attributes":{},"insert":"\n"},{"attributes":{"size":"12px","color":"#ffffff"},"insert":"BA\t-\tBatch Apex Start"},{"attributes":{},"insert":"\n"},{"attributes":{"size":"12px","color":"#ffffff"},"insert":"C\t-\tScheduled Apex"},{"attributes":{},"insert":"\n"},{"attributes":{"size":"12px","color":"#ffffff"},"insert":"CI\t-\tCommerce Integration"},{"attributes":{},"insert":"\n"},{"attributes":{"size":"12px","color":"#ffffff"},"insert":"DL\t-\t Discoverable Login page"},{"attributes":{},"insert":"\n"},{"attributes":{"size":"12px","color":"#ffffff"},"insert":"E\t-\tInbound Email Service"},{"attributes":{},"insert":"\n"},{"attributes":{"size":"12px","color":"#ffffff"},"insert":"F\t-\tFuture"},{"attributes":{},"insert":"\n"},{"attributes":{"size":"12px","color":"#ffffff"},"insert":"FC\t-\tFunction Callback"},{"attributes":{},"insert":"\n"},{"attributes":{"size":"12px","color":"#ffffff"},"insert":"H\t-\tApex REST"},{"attributes":{},"insert":"\n"},{"attributes":{"size":"12px","color":"#ffffff"},"insert":"I\t-\tInvocable Action"},{"attributes":{},"insert":"\n"},{"attributes":{"size":"12px","color":"#ffffff"},"insert":"K\t-\tQuick Action"},{"attributes":{},"insert":"\n"},{"attributes":{"size":"12px","color":"#ffffff"},"insert":"L\t-\tLightning"},{"attributes":{},"insert":"\n"},{"attributes":{"size":"12px","color":"#ffffff"},"insert":"M\t-\tRemote Action"},{"attributes":{},"insert":"\n"},{"attributes":{"size":"12px","color":"#ffffff"},"insert":"P\t-\tBulk Apex Parallel"},{"attributes":{},"insert":"\n"},{"attributes":{"size":"12px","color":"#ffffff"},"insert":"Q\t-\tQueueable"},{"attributes":{},"insert":"\n"},{"attributes":{"size":"12px","color":"#ffffff"},"insert":"R\t-\tSynchronous"},{"attributes":{},"insert":"\n"},{"attributes":{"size":"12px","color":"#ffffff"},"insert":"S\t-\tQueryLocator Batch Apex"},{"attributes":{},"insert":"\n"},{"attributes":{"size":"12px","color":"#ffffff"},"insert":"TA\t-\tTests Async"},{"attributes":{},"insert":"\n"},{"attributes":{"size":"12px","color":"#ffffff"},"insert":"TD\t-\tTests Deployment"},{"attributes":{},"insert":"\n"},{"attributes":{"size":"12px","color":"#ffffff"},"insert":"TS\t-\tTests Synchronous"},{"attributes":{},"insert":"\n"},{"attributes":{"size":"12px","color":"#ffffff"},"insert":"V\t-\tVisualforce"},{"attributes":{},"insert":"\n"},{"attributes":{"size":"12px","color":"#ffffff"},"insert":"W\t-\tSOAP Webservices"},{"attributes":{},"insert":"\n"},{"attributes":{"size":"12px","color":"#ffffff"},"insert":"X\t-\tExecute Anonymous"},{"attributes":{"align":"left"},"insert":"\n"}]},"interactions":[],"showActionMenu":true},"type":"text"},"text_32":{"parameters":{"content":{"richTextContent":[{"attributes":{"size":"12px","color":"#ffffff"},"insert":"These tables show which is the slowest class and method for each type of Apex. It is recommended to look at average run time across the different types of Apex because they have different use-cases, expectations, and performance thresholds."},{"attributes":{},"insert":"\n\n\n\n"},{"attributes":{"size":"12px","color":"#ffffff"},"insert":"For example, most executions would occur under 'Synchronous', which means a user performs an action and has to wait for that execution to finish before their page reloads or they navigate onwards. For this reason, a performance threshold of 5 seconds is important. For Batch Apex, there isn't neccessarily a time limit since it runs in the background. However, long-running Batch Apex may indicate sub-optimal code and could delay other batch jobs that are scheduled behind it in the queue."},{"attributes":{"align":"left"},"insert":"\n"}]},"interactions":[],"showActionMenu":true},"type":"text"},"text_31":{"parameters":{"content":{"richTextContent":[{"attributes":{"color":"#ffffff","size":"20px"},"insert":"Org Health"},{"attributes":{"align":"left"},"insert":"\n"}]},"interactions":[],"showActionMenu":true,"tooltip":""},"type":"text"},"text_34":{"parameters":{"content":{"richTextContent":[{"attributes":{"size":"14px","color":"#e6ecf2"},"insert":"Details Table"},{"attributes":{"align":"left"},"insert":"\n"}]},"interactions":[],"showActionMenu":true},"type":"text"},"text_33":{"parameters":{"content":{"richTextContent":[{"attributes":{"size":"14px","color":"#e6ecf2"},"insert":"Summary Data Table"},{"attributes":{"align":"left"},"insert":"\n"}]},"interactions":[],"showActionMenu":true},"type":"text"},"filterpanel_9":{"parameters":{"filterItemOptions":{"propertyColor":"#54698D","valueColor":"#16325C"},"filters":[{"field":"ExceptionType","sobject":"ApexUnexpectedExcpEventLog"}],"showAllFilters":false},"type":"filterpanel"},"text_30":{"parameters":{"content":{"richTextContent":[{"attributes":{"color":"#ffffff","size":"20px"},"insert":"Top Performance Issues"},{"attributes":{"align":"left"},"insert":"\n"}]},"interactions":[],"showActionMenu":true},"type":"text"},"filterpanel_8":{"parameters":{"filterItemOptions":{"propertyColor":"#54698D","valueColor":"#16325C"},"fil